# ============================================================
# Copia este archivo a ".env" (sin ".example") y reemplaza los
# valores. El archivo ".env" real NUNCA se comparte ni se sube
# a internet -- contiene contrasenas reales.
# ============================================================

# Contrasena del usuario root de MySQL (solo la usa el propio contenedor)
DB_ROOT_PASSWORD=cambia_esto_por_algo_seguro

# Usuario y contrasena que usara el backend para conectarse a MySQL
DB_USERNAME=elpuntazo_app
DB_PASSWORD=cambia_esto_tambien

# Clave secreta para firmar los tokens de sesion (JWT).
# Debe ser larga y aleatoria. Puedes generar una con:
#   openssl rand -base64 64
JWT_SECRET=cambia_esto_por_una_cadena_larga_y_aleatoria

# Duracion de la sesion en milisegundos (28800000 = 8 horas)
JWT_EXPIRATION_MS=28800000

# Dominio(s) desde donde se permite usar la aplicacion.
# Al inicio, mientras no tengas dominio, usa la IP del servidor:
#   http://IP_DE_TU_SERVIDOR
# Cuando tengas dominio, cambia a:
#   https://app.elpuntazo.com
ALLOWED_ORIGINS=http://localhost

# Credenciales del PRIMER administrador. Solo se usan la primera
# vez que arranca el sistema (si ya existe un admin, se ignoran).
INITIAL_ADMIN_EMAIL=admin@elpuntazo.com
INITIAL_ADMIN_PASSWORD=cambia_esto_por_una_contrasena_segura
INITIAL_ADMIN_NAME=Administrador

# Segundo administrador. Mismos permisos que el primero.
# Se crea al arrancar solo si ese correo todavia no existe; a los
# usuarios ya creados nunca se les toca nada.
SECOND_ADMIN_EMAIL=
SECOND_ADMIN_PASSWORD=
SECOND_ADMIN_NAME=Administrador
